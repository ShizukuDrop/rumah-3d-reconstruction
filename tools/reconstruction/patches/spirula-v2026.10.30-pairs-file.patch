diff --git a/src/sfm/feature/PairList.h b/src/sfm/feature/PairList.h
new file mode 100644
index 0000000..c27d37e
--- /dev/null
+++ b/src/sfm/feature/PairList.h
@@ -0,0 +1,119 @@
+#pragma once
+
+#include <algorithm>
+#include <cctype>
+#include <cstdint>
+#include <fstream>
+#include <map>
+#include <set>
+#include <stdexcept>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include "core/Sha256.h"
+#include "data/Json.h"
+
+namespace sfm {
+
+struct NamedPairList {
+    std::string sha256;
+    std::vector<std::pair<std::string, std::string>> pairs;
+};
+
+inline std::string pairImageName(std::string name) {
+    std::replace(name.begin(), name.end(), '\\', '/');
+    if (name.empty() || name.front() == '/' || name.find(':') != std::string::npos ||
+        name.find('\0') != std::string::npos)
+        throw std::runtime_error("pair image name must be relative: " + name);
+    std::string out;
+    for (size_t a = 0; a < name.size();) {
+        const size_t b = name.find('/', a);
+        const std::string part = name.substr(a, b == std::string::npos ? b : b - a);
+        if (part == "..") throw std::runtime_error("pair image name contains '..': " + name);
+        if (!part.empty() && part != ".") out += (out.empty() ? "" : "/") + part;
+        if (b == std::string::npos) break;
+        a = b + 1;
+    }
+    if (out.empty()) throw std::runtime_error("empty pair image name");
+    return out;
+}
+
+inline std::string pairImageStem(const std::string& name) {
+    const size_t dot = name.find_last_of('.');
+    if (dot == std::string::npos) return name;
+    std::string ext = name.substr(dot);
+    std::transform(ext.begin(), ext.end(), ext.begin(),
+                   [](unsigned char c) { return (char)std::tolower(c); });
+    for (const char* known : {".jpg", ".jpeg", ".png", ".webp", ".tif", ".tiff", ".bmp"})
+        if (ext == known) return name.substr(0, dot);
+    return name;
+}
+
+inline NamedPairList parsePairList(const std::string& text) {
+    NamedPairList out;
+    spirula::Sha256 digest;
+    digest.update(reinterpret_cast<const uint8_t*>(text.data()), text.size());
+    out.sha256 = digest.hex();
+    const JsonValue doc = json_parse(text);
+    const JsonValue* rows = doc.is_array() ? &doc : doc.find("candidateEdges");
+    if (!rows || !rows->is_array() || rows->arr.empty())
+        throw std::runtime_error("pair list needs a nonempty array or candidateEdges array");
+    std::set<std::pair<std::string, std::string>> unique;
+    for (const JsonValue& row : rows->arr) {
+        const JsonValue* a = row.is_array() && row.arr.size() == 2 ? &row.arr[0] : row.find("image1");
+        const JsonValue* b = row.is_array() && row.arr.size() == 2 ? &row.arr[1] : row.find("image2");
+        if (!a || !b || a->type != JsonValue::Type::String || b->type != JsonValue::Type::String)
+            throw std::runtime_error("pair entry needs two image names");
+        std::string first = pairImageName(a->str), second = pairImageName(b->str);
+        if (first == second) throw std::runtime_error("self pair: " + first);
+        if (second < first) std::swap(first, second);
+        unique.emplace(first, second);
+    }
+    out.pairs.assign(unique.begin(), unique.end());
+    return out;
+}
+
+inline NamedPairList readPairList(const std::string& path) {
+    std::ifstream in(path, std::ios::binary | std::ios::ate);
+    if (!in) throw std::runtime_error("cannot open pair list: " + path);
+    const auto size = in.tellg();
+    if (size < 0 || size > 64 * 1024 * 1024)
+        throw std::runtime_error("pair list exceeds 64 MiB: " + path);
+    std::string text((size_t)size, '\0');
+    in.seekg(0);
+    if (!in.read(text.data(), (std::streamsize)text.size()))
+        throw std::runtime_error("cannot read complete pair list: " + path);
+    return parsePairList(text);
+}
+
+inline std::vector<std::pair<uint32_t, uint32_t>> resolvePairList(
+    const NamedPairList& list, const std::vector<std::string>& images) {
+    std::map<std::string, std::set<uint32_t>> names;
+    for (size_t i = 0; i < images.size(); ++i) {
+        const std::string name = pairImageName(images[i]);
+        names[name].insert((uint32_t)i);
+        names[pairImageStem(name)].insert((uint32_t)i);
+    }
+    auto resolve = [&](const std::string& name) {
+        std::set<uint32_t> ids;
+        for (const std::string& key : {name, pairImageStem(name)}) {
+            const auto found = names.find(key);
+            if (found != names.end()) ids.insert(found->second.begin(), found->second.end());
+        }
+        if (ids.size() != 1)
+            throw std::runtime_error((ids.empty() ? "unknown" : "ambiguous") +
+                                     std::string(" pair image name: ") + name);
+        return *ids.begin();
+    };
+    std::set<std::pair<uint32_t, uint32_t>> unique;
+    for (const auto& pair : list.pairs) {
+        uint32_t a = resolve(pair.first), b = resolve(pair.second);
+        if (a == b) throw std::runtime_error("pair aliases resolve to one image");
+        if (b < a) std::swap(a, b);
+        unique.emplace(a, b);
+    }
+    return {unique.begin(), unique.end()};
+}
+
+}  // namespace sfm
diff --git a/src/sfm/tests/sfm_pair_list_test.cpp b/src/sfm/tests/sfm_pair_list_test.cpp
new file mode 100644
index 0000000..b3786d5
--- /dev/null
+++ b/src/sfm/tests/sfm_pair_list_test.cpp
@@ -0,0 +1,47 @@
+#include <cstdio>
+#include <stdexcept>
+#include <string>
+#include <vector>
+
+#include "sfm/feature/PairList.h"
+#include "sfm/tests/TestMain.h"
+
+static void require(bool ok, const char* why) {
+    if (!ok) throw std::runtime_error(why);
+}
+
+template <typename Fn> static void rejects(Fn fn) {
+    try { fn(); } catch (const std::runtime_error&) { return; }
+    throw std::runtime_error("invalid pair list accepted");
+}
+
+static int run(int, char**) {
+    using namespace sfm;
+    const NamedPairList list = parsePairList(
+        R"({"candidateEdges":[{"image1":"./cam1/b.jpg","image2":"cam0\\a.jpg"},)"
+        R"({"image1":"cam0/a.jpg","image2":"cam1/b.jpg"}]})");
+    require(list.pairs.size() == 1, "normalize and deduplicate names");
+    const std::vector<std::string> images = {"unrequested", "cam1/b", "cam0/a"};
+    const auto pairs = resolvePairList(list, images);
+    require(pairs.size() == 1 && pairs[0].first == 1 && pairs[0].second == 2,
+            "preserve original image IDs including unrequested images");
+    const auto alias = parsePairList(R"([["cam0/a","cam1/b"],["cam1/b.jpg","cam0/a.jpg"]])");
+    require(resolvePairList(alias, images) == pairs, "deduplicate aliases after ID resolution");
+    require(list.sha256 != alias.sha256, "content hash detects changed input");
+    require(parsePairList(R"([["a","b"]])").sha256 ==
+            parsePairList(R"([["a","b"]])").sha256, "stable content hash");
+    rejects([] { parsePairList("[]"); });
+    rejects([] { parsePairList(R"([["a","a"]])"); });
+    rejects([] { parsePairList(R"([["../a","b"]])"); });
+    rejects([] { parsePairList(R"([["C:/a","b"]])"); });
+    rejects([] { parsePairList(R"([["/a","b"]])"); });
+    rejects([] { parsePairList(R"([["a",2]])"); });
+    rejects([] { parsePairList(R"([["a","b","c"]])"); });
+    rejects([&] { resolvePairList(list, {"cam0/a"}); });
+    rejects([&] { resolvePairList(list, {"cam0/a", "cam0/a.jpg", "cam1/b"}); });
+    rejects([] { resolvePairList(parsePairList(R"([["a","a.jpg"]])"), {"a"}); });
+    std::puts("pair list: all CPU-only tests passed");
+    return 0;
+}
+
+int main(int argc, char** argv) { return sfmTestMain(argc, argv, run); }
